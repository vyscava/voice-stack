# =============================================================================
# Voice Stack — example configuration
# =============================================================================
# Copy to .env and edit:
#
#     cp .env.example .env
#
# Values below are the application defaults from src/core/settings.py, EXCEPT
# where a comment says otherwise. Deviations are called out explicitly so this
# file never silently disagrees with the code.
#
# Comments are on their own lines, never trailing a value. Compose's .env parser
# does strip them, but `docker run --env-file` does NOT -- there `FOO=bar  # note`
# passes the literal string "bar  # note" into the application. Keeping comments
# on their own lines makes this file safe for both.
#
# One image serves both services; SERVICE_MODE picks which one a container
# runs. Variables for the other service are ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Service selection
# -----------------------------------------------------------------------------
# Required when running the image directly. The entrypoint exits 1 if unset and
# rejects anything other than asr|tts.
SERVICE_MODE=tts

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# NOT THE DEFAULT. settings.py ships "Not Yet a Service to Share", which is
# used as the public OpenAPI title on /docs. Set something real before anyone
# else sees your instance.
PROJECT_NAME=Voice Stack
ENV=dev
DEBUG=false
HOST=0.0.0.0

# NOT THE DEFAULT. settings.py defaults to "INFO" (uppercase), which is wrong:
# uvicorn rejects it and exits immediately with
#   Error: Invalid value for '--log-level': 'INFO' is not one of
#   'critical', 'error', 'warning', 'info', 'debug', 'trace'
# Always set this lowercase.
LOG_LEVEL=info

ASR_PORT=5001
TTS_PORT=5002

# Prefix for every route AND the OpenAPI URL. Default is empty, and it must stay
# empty unless you know what you are doing: the routers already carry their own
# prefixes, so API_V1_STR=/v1 yields /v1/v1/audio/transcriptions.
API_V1_STR=

# Python logger names. Cosmetic; change only if you are wiring custom log routing.
ASR_LOG_NAME=asr.app
TTS_LOG_NAME=tts.app

# Comma-separated, e.g. https://example.com,https://app.example.com
# Empty disables CORS. Do not use "*" on anything reachable from outside.
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# ASR — speech to text
# -----------------------------------------------------------------------------
# fasterwhisper | whisper
ASR_ENGINE=fasterwhisper

# cpu | cuda | auto
ASR_DEVICE=cpu

# tiny | base | small | medium | large-v3 | large-v3-turbo, or a local path.
# Downloaded on first request: base is ~150 MB, large-v3 is ~3 GB.
ASR_MODEL=base

# Unset (the default) caches models in the HuggingFace cache directory. Set
# this if you mount a volume at a known path — a volume mounted anywhere else
# silently caches nothing.
# ASR_MODEL_LOCATION=/app/models

# int8 suits CPU. Use float16 on a GPU; int8_float16 is a middle ground.
ASR_COMPUTE_TYPE=int8

ASR_CPU_THREADS=8
ASR_NUM_OF_WORKERS=1
ASR_MAX_CONCURRENT_REQUESTS=2

ASR_CACHE_ENABLED=true
ASR_CACHE_MAX_ITEMS=64
ASR_VAD_ENABLED=true

# Force a language instead of auto-detecting, e.g. en, pt, es.
# ASR_TRANSCRIBE_LANG=en

# Decoding parameters. Higher beam_size trades speed for accuracy.
# best_of only applies when beam_size == 1 (sampling rather than beam search).
ASR_TRANSCRIBE_BEAM_SIZE=5
ASR_TRANSCRIBE_TEMPERATURE=0.0
ASR_TRANSCRIBE_BEST_OF=1

# Minutes of inactivity before the model is unloaded. 0 keeps it resident,
# trading RAM for predictable latency.
ASR_IDLE_TIMEOUT_MINUTES=60

# -----------------------------------------------------------------------------
# TTS — text to speech
# -----------------------------------------------------------------------------
# coqui only, for now
TTS_ENGINE=coqui

# cuda | cpu | mps
TTS_DEVICE=cpu

# XTTS v2 downloads ~1.8 GB on first request and is cached in a volume.
# CPU synthesis works but is slow; use cuda for anything interactive.
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Directory of .wav reference clips. Each file becomes a selectable voice named
# after the file (my-voice.wav -> voice "my-voice"). In Docker this is
# /app/voices; mount your clips there.
TTS_VOICES_DIR=voices

TTS_SAMPLE_RATE=24000

# Text is split into chunks between MIN and MAX characters before synthesis.
TTS_MAX_CHARS=180
TTS_MIN_CHARS=70
TTS_RETRY_STEPS=2

TTS_DEFAULT_LANG=en
TTS_AUTO_LANG=true

# Bias auto-detection toward a language without forcing it.
# TTS_LANG_HINT=pt

# Force a language, disabling auto-detection entirely.
# TTS_FORCE_LANG=pt

# Minutes of inactivity before the model is unloaded. XTTS takes tens of
# seconds to reload, so 0 trades ~2 GB of RAM for predictable latency.
TTS_IDLE_TIMEOUT_MINUTES=60

# XTTS is memory-hungry. Raising this past available RAM causes OOM kills
# rather than queuing.
TTS_MAX_CONCURRENT_REQUESTS=2

# -----------------------------------------------------------------------------
# Limits and resource guards
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100

# Requests are rejected with HTTP 503 above these thresholds, so the process
# degrades instead of being OOM-killed.
MEMORY_THRESHOLD_PERCENT=90
SWAP_THRESHOLD_PERCENT=80

# -----------------------------------------------------------------------------
# Debugging (leave off in production)
# -----------------------------------------------------------------------------
DEBUG_PRESERVE_FAILED_UPLOADS=false
DEBUG_PRESERVE_DIR=/tmp/voice-stack-debug

DEBUGPY_ENABLE=false
DEBUGPY_HOST=0.0.0.0
DEBUGPY_PORT=5678
DEBUGPY_WAIT_FOR_CLIENT=false

# -----------------------------------------------------------------------------
# Gateway — spoken exchanges with an agent (SERVICE_MODE=gateway)
# -----------------------------------------------------------------------------
# Only used in gateway mode. The gateway holds no model: it calls the ASR and
# TTS services over HTTP and asks an agent on a NATS bus for the answer.
# If you have no agent bus, ignore this whole section.
GATEWAY_PORT=5003

GATEWAY_ASR_URL=http://localhost:5001
GATEWAY_TTS_URL=http://localhost:5002

# The subject is agents.<SELF_NAME>.dm.<AGENT>.<TOPIC>, which reads
# from .dm. to. If your bus restricts publishing to agents.<self>.>, a wrong
# SELF_NAME is rejected asynchronously: the send looks like it worked and the
# message never arrives.
GATEWAY_SELF_NAME=voice-gateway
GATEWAY_AGENT=claude-code-channel
GATEWAY_NATS_URL=nats://localhost:4222
GATEWAY_NATS_TOPIC=voice

# Bounds the connect AND the request, so an exchange can never hang.
GATEWAY_AGENT_TIMEOUT_S=60
GATEWAY_ASR_TIMEOUT_S=120
GATEWAY_TTS_TIMEOUT_S=300

# A stock speaker by default, on purpose: a cloned voice belongs to the person
# it was cloned from, and a default should never leak one by accident.
GATEWAY_VOICE=Claribel Dervla
GATEWAY_AUDIO_FORMAT=opus

# Leave unset to auto-detect.
# GATEWAY_LANGUAGE=pt

# Shorter transcripts are treated as noise and never sent to the agent, so a
# cough does not become a question.
GATEWAY_MIN_TRANSCRIPT_CHARS=2
