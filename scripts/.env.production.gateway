# =============================================================================
# Voice Stack Gateway - production configuration template
# =============================================================================
# Copy to .env, or set these as environment variables on the container.
#
# The gateway holds no model. It calls the ASR and TTS services over HTTP and
# reaches an agent over NATS, so nearly all of its configuration is addresses
# and timeouts.
#
# Comments are on their own lines. Docker's --env-file parser does not strip
# trailing comments, so `FOO=bar  # note` passes the literal "bar  # note".
# =============================================================================

SERVICE_MODE=gateway

ENV=production
# Lowercase. uvicorn exits on "INFO".
LOG_LEVEL=info
HOST=0.0.0.0
GATEWAY_PORT=5003

# Empty disables CORS. Do not use "*" on anything reachable from outside.
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Where the heavy services live
# -----------------------------------------------------------------------------
# Use hostnames, not addresses.
GATEWAY_ASR_URL=http://voice-stack-asr:5001
GATEWAY_TTS_URL=http://voice-stack-tts:5002

# -----------------------------------------------------------------------------
# Which agent answers, and as whom
# -----------------------------------------------------------------------------
# GATEWAY_SELF_NAME must match this service's identity on the bus EXACTLY.
# NATS allows publishing only under agents.<self>.>, and a mismatch is rejected
# asynchronously: the publish still reports success and the message vanishes.
GATEWAY_SELF_NAME=voice-gateway
GATEWAY_AGENT=claude-code-channel
GATEWAY_NATS_URL=nats://homelab-nats:4222
GATEWAY_NATS_TOPIC=voice

# -----------------------------------------------------------------------------
# Timeouts
# -----------------------------------------------------------------------------
# The agent is the slow part of an exchange, not ASR: measured ASR real-time
# factor is 0.006-0.020, so a 10 s utterance transcribes in about 0.1 s.
GATEWAY_AGENT_TIMEOUT_S=60
GATEWAY_ASR_TIMEOUT_S=120
GATEWAY_TTS_TIMEOUT_S=300

# -----------------------------------------------------------------------------
# The voice it speaks in
# -----------------------------------------------------------------------------
# A STOCK speaker by default, on purpose. Cloned voices of real people are
# private to this network, and a default must never leak one by accident.
GATEWAY_VOICE=Claribel Dervla
GATEWAY_AUDIO_FORMAT=opus

# Leave unset to auto-detect the language.
# GATEWAY_LANGUAGE=pt

# Transcripts shorter than this are treated as noise and never sent to the
# agent, so a cough does not become a question.
GATEWAY_MIN_TRANSCRIPT_CHARS=2
